# EcivreS Platform — Staging Environment Configuration Template (.env.staging.example)
# DevSecOps Notice: Never commit live credentials or production secrets.

# Core Runtime Environment
NODE_ENV=staging
APP_ENV=staging
API_PORT=5001
PORT=5001
LOG_LEVEL=info

# Staging Database (AWS RDS PostgreSQL 16 Private Subnet)
# Format: postgresql://<user>:<password>@<rds-staging-endpoint>:5432/ecivres_staging?schema=public&sslmode=require
DATABASE_URL="postgresql://ecivres_staging_user:SECURE_PASSWORD_FROM_SECRETS_MGR@staging-db.ecivres.internal:5432/ecivres_staging?schema=public&sslmode=require"
POSTGRES_USER=ecivres_staging_user
POSTGRES_PASSWORD=SECURE_PASSWORD_FROM_SECRETS_MGR
POSTGRES_DB=ecivres_staging

# Staging Cache & Queue (AWS ElastiCache Redis 7)
REDIS_HOST=staging-redis.ecivres.internal
REDIS_PORT=6379
REDIS_PASSWORD=SECURE_REDIS_AUTH_TOKEN
REDIS_TLS_ENABLED=true

# High-Entropy Cryptographic Secrets (Injected via AWS Secrets Manager)
JWT_ACCESS_SECRET=staging_kms_derived_access_token_secret_min_64_bytes_entropy_2026_xyz
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=staging_kms_derived_refresh_token_secret_min_64_bytes_entropy_2026_xyz
JWT_REFRESH_EXPIRES_IN=7d

# CORS Whitelist for Staging Ingress
CORS_ORIGINS=https://staging.ecivres.com,https://staging-api.ecivres.com

# Web Client Public Ingress
NEXT_PUBLIC_API_URL=https://staging-api.ecivres.com/api/v1
NEXT_PUBLIC_APP_ENV=staging

# Third-Party Sandboxes
STRIPE_SECRET_KEY=sk_test_staging_placeholder_51xxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_staging_placeholder_xxxxxxxxxxxxxx

# Observability & Alerting
SENTRY_DSN=https://staging_key@o0000.ingest.sentry.io/0000000
PROMETHEUS_METRICS_ENABLED=true
ENABLE_SWAGGER=true
