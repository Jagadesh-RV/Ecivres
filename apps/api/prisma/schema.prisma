generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  customerProfile CustomerProfile?
  providerProfile ProviderProfile?
  refreshTokens   RefreshToken[]
  bookings        Booking[]
  reviews         Review[]
  notifications   Notification[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  businessName   String
  description    String?
  phone          String?
  address        String?
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([isVerified])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]
}

model Service {
  id          String   @id @default(uuid())
  providerId  String
  categoryId  String
  name        String
  description String?
  price       Float
  duration    Int      // Duration in minutes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id])
  bookings Booking[]
}

model Booking {
  id          String        @id @default(uuid())
  customerId  String
  serviceId   String
  status      BookingStatus @default(PENDING)
  scheduledAt DateTime
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customer User    @relation(fields: [customerId], references: [id])
  service  Service @relation(fields: [serviceId], references: [id])
  payment  Payment?
  review   Review?

  @@index([customerId, status])
  @@index([serviceId, status])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  amount        Float
  status        PaymentStatus @default(PENDING)
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  authorId   String
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Referral {
  id             String         @id @default(uuid())
  referrerId     String
  referredUserId String?
  code           String         @unique
  status         ReferralStatus @default(PENDING)
  rewardAmount   Float          @default(15.00)
  createdAt      DateTime       @default(now())
  redeemedAt     DateTime?
}

enum ReferralStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}
model Device {
  id              String   @id @default(uuid())
  deviceId        String   @unique
  name            String
  deviceType      String
  ownerId         String
  healthScore     Float    @default(100.0)
  status          String   @default("ONLINE")
  lastHeartbeatAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

model InsuranceClaim {
  id              String   @id @default(uuid())
  claimId         String   @unique
  policyNumber    String
  providerId      String
  estimatedCost   Float
  approvedCost    Float?
  status          String   @default("PENDING")
  filedAt         DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([providerId])
  @@index([status])
}

model FranchiseBranch {
  id              String   @id @default(uuid())
  branchId        String   @unique
  franchiseId     String
  name            String
  territoryCode   String
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([franchiseId])
  @@index([territoryCode])
}

model SupplierPO {
  id              String   @id @default(uuid())
  orderId         String   @unique
  supplierId      String
  totalAmount     Float
  status          String   @default("ISSUED")
  issuedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
}

model LicenseVerification {
  id              String   @id @default(uuid())
  verificationId  String   @unique
  providerId      String
  licenseType     String
  licenseNumber   String
  status          String   @default("PENDING")
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([providerId])
}

model VerifiableCredential {
  id              String   @id @default(uuid())
  credentialId    String   @unique
  userId          String
  credentialType  String
  issuer          String
  isValid         Boolean  @default(true)
  issuedAt        DateTime @default(now())

  @@index([userId])
}

model SmartCityRequest {
  id              String   @id @default(uuid())
  requestId       String   @unique
  municipalityId  String
  category        String
  priority        String   @default("MEDIUM")
  status          String   @default("OPEN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([municipalityId])
  @@index([status])
}

model IncidentReport {
  id              String   @id @default(uuid())
  incidentId      String   @unique
  serviceName     String
  severity        String   @default("WARNING")
  status          String   @default("OPEN")
  remediatedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([serviceName])
  @@index([status])
}

model EdgeWorkerRoute {
  id              String   @id @default(uuid())
  routeId         String   @unique
  regionCode      String
  originUrl       String
  edgeUrl         String
  latencyMs       Int      @default(15)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([regionCode])
}
model LoyaltyAccount {
  id              String   @id @default(uuid())
  userId          String   @unique
  tier            String   @default("BRONZE")
  points          Int      @default(0)
  cashbackBalance Float    @default(0.0)
  referralCode    String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tier])
}

model AdCampaign {
  id              String   @id @default(uuid())
  campaignId      String   @unique
  providerId      String
  title           String
  bidCpc          Float
  budget          Float
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([providerId])
  @@index([status])
}

model CustomerCrmRecord {
  id              String   @id @default(uuid())
  recordId        String   @unique
  providerId      String
  customerId      String
  leadScore       Int      @default(50)
  notes           String?
  nextFollowUpAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([providerId, customerId])
}

model ProcurementContract {
  id              String   @id @default(uuid())
  contractId      String   @unique
  organizationId  String
  vendorName      String
  totalBudget     Float
  status          String   @default("PENDING_APPROVAL")
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model WorkforceShift {
  id              String   @id @default(uuid())
  shiftId         String   @unique
  organizationId  String
  staffId         String
  startTime       DateTime
  endTime         DateTime
  overtimeHours   Float    @default(0.0)
  status          String   @default("SCHEDULED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, staffId])
}

model KnowledgeGraphEdge {
  id              String   @id @default(uuid())
  edgeId          String   @unique
  sourceEntity    String
  targetEntity    String
  relationship    String
  weight          Float    @default(1.0)
  createdAt       DateTime @default(now())

  @@index([sourceEntity, targetEntity])
}

model SmartContractEscrow {
  id              String   @id @default(uuid())
  escrowId        String   @unique
  bookingId       String   @unique
  amount          Float
  milestone       String
  isReleased      Boolean  @default(false)
  disputeStatus   String   @default("NONE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isReleased])
}

model ApiMarketplaceApp {
  id              String   @id @default(uuid())
  appId           String   @unique
  developerId     String
  name            String
  apiKey          String   @unique
  ratePlan        String   @default("FREE")
  monthlyRequests Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([developerId])
}

model BiAnalyticsReport {
  id              String   @id @default(uuid())
  reportId        String   @unique
  title           String
  metricsJson     String
  generatedAt     DateTime @default(now())
}

model AutonomousRecoveryAction {
  id              String   @id @default(uuid())
  actionId        String   @unique
  clusterName     String
  targetDeployment String
  reason          String
  status          String   @default("SUCCESS")
  executedAt      DateTime @default(now())

  @@index([clusterName])
}

model EdgeInferenceCache {
  id              String   @id @default(uuid())
  cacheId         String   @unique
  region          String
  modelKey        String
  latencyMs       Int      @default(8)
  updatedAt       DateTime @updatedAt

  @@index([region, modelKey])
}
model FranchiseNetwork {
  id              String   @id @default(uuid())
  networkId       String   @unique
  regionCode      String
  name            String
  royaltyRate     Float    @default(0.08)
  activeBranches  Int      @default(1)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([regionCode])
}

model EmergencySosBooking {
  id              String   @id @default(uuid())
  sosId           String   @unique
  customerId      String
  serviceCategory String
  latitude        Float
  longitude       Float
  priorityScore   Int      @default(100)
  status          String   @default("DISPATCHED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model InsuranceDamageClaim {
  id              String   @id @default(uuid())
  damageClaimId   String   @unique
  policyId        String
  providerId      String
  assessedAmount  Float
  coverageValid   Boolean  @default(true)
  status          String   @default("UNDER_REVIEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([policyId])
}

model SmartHomeDevice {
  id              String   @id @default(uuid())
  smartDeviceId   String   @unique
  homeId          String
  deviceType      String
  telemetryTopic  String
  lastStatus      String   @default("HEALTHY")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([homeId])
}

model WorkforceSchedule {
  id              String   @id @default(uuid())
  scheduleId      String   @unique
  organizationId  String
  weekNumber      Int
  aiOptimized     Boolean  @default(true)
  totalShiftHours Float    @default(160.0)
  createdAt       DateTime @default(now())

  @@index([organizationId])
}

model ProcurementPurchaseRequest {
  id              String   @id @default(uuid())
  requestId       String   @unique
  organizationId  String
  itemDescription String
  estimatedCost   Float
  approvalLevel   String   @default("MANAGER")
  status          String   @default("SUBMITTED")
  createdAt       DateTime @default(now())

  @@index([organizationId])
}

model CommerceGraphNode {
  id              String   @id @default(uuid())
  nodeId          String   @unique
  entityType      String
  label           String
  propertiesJson  String
  createdAt       DateTime @default(now())

  @@index([entityType])
}

model AutonomousSettlement {
  id              String   @id @default(uuid())
  settlementId    String   @unique
  escrowId        String
  grossAmount     Float
  platformFee     Float
  netPayout       Float
  status          String   @default("SETTLED")
  settledAt       DateTime @default(now())

  @@index([escrowId])
}

model DeveloperWebhook {
  id              String   @id @default(uuid())
  webhookId       String   @unique
  appId           String
  targetUrl       String
  eventsJson      String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([appId])
}

model OpsScalingAction {
  id              String   @id @default(uuid())
  scalingId       String   @unique
  clusterId       String
  targetReplicas  Int
  triggerMetric   String
  executedAt      DateTime @default(now())

  @@index([clusterId])
}

model EdgeOfflineInference {
  id              String   @id @default(uuid())
  inferenceId     String   @unique
  edgeNodeId      String
  inputHash       String
  outputJson      String
  latencyMs       Int      @default(5)
  executedAt      DateTime @default(now())

  @@index([edgeNodeId])
}
model StripeConnectAccount {
  id              String   @id @default(uuid())
  providerId      String   @unique
  stripeAccountId String   @unique
  onboardingUrl   String?
  payoutsEnabled  Boolean  @default(false)
  detailsSubmitted Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([providerId])
}

model IndianVerificationRecord {
  id                String   @id @default(uuid())
  providerId        String   @unique
  aadhaarHash       String?
  panNumber         String?
  gstin             String?
  businessLicenseNo String?
  verificationStatus String  @default("PENDING")
  verifiedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([providerId])
  @@index([verificationStatus])
}

model OcrExtractedDocument {
  id            String   @id @default(uuid())
  documentId    String   @unique
  userId        String
  documentType  String
  extractedText String
  confidence    Float    @default(0.95)
  status        String   @default("PARSED")
  createdAt     DateTime @default(now())

  @@index([userId])
}

model FraudRiskScore {
  id                String   @id @default(uuid())
  targetId          String   @unique
  targetType        String
  behavioralScore   Int      @default(0)
  anomalyDetected   Boolean  @default(false)
  fakeReviewRisk    Float    @default(0.0)
  riskLevel         String   @default("LOW")
  updatedAt         DateTime @updatedAt

  @@index([targetId, targetType])
}

model MarketplaceAnalyticsEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  userId      String?
  payloadJson String
  timestamp   DateTime @default(now())

  @@index([eventType])
  @@index([timestamp])
}

model OperationsIncident {
  id          String   @id @default(uuid())
  incidentId  String   @unique
  severity    String   @default("MEDIUM")
  title       String
  description String
  status      String   @default("OPEN")
  slaBreached Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([severity])
  @@index([status])
}


enum ViralReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED_FRAUD
}

model ReferralTreeRecord {
  id               String         @id @default(uuid())
  referrerId       String
  refereeId        String         @unique
  referralCode     String
  qrCodeUrl        String?
  status           ViralReferralStatus @default(PENDING)
  rewardAmountUsd  Float          @default(15.0)
  rewardEarnedAt   DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([referrerId])
  @@index([referralCode])
}


model CountryRecord {
  id               String   @id @default(uuid())
  code             String   @unique // ISO 2-letter e.g. US, IN, GB, AE
  name             String
  currencyCode     String   // e.g. USD, INR, GBP, AED
  currencySymbol   String   // e.g. $, ₹, £, AED
  defaultLanguage  String   @default("en")
  isRtl            Boolean  @default(false)
  isActive         Boolean  @default(true)
  taxType          String   @default("VAT") // VAT, GST, SALES_TAX
  taxRatePercent   Float    @default(0.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([code])
}

model AcquisitionRecord {
  id              String   @id @default(uuid())
  userId          String   @unique
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  referrerUrl     String?
  referralCode    String?
  firstSearchAt   DateTime?
  firstBookingAt  DateTime?
  firstPaymentAt  DateTime?
  acquisitionCost Float    @default(0.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([utmSource])
  @@index([utmCampaign])
}

model MarketingCampaign {
  id              String   @id @default(uuid())
  title           String
  code            String   @unique
  description     String?
  discountType    String   // PERCENTAGE, FIXED
  discountValue   Float
  minOrderValue   Float    @default(0.0)
  maxDiscount     Float?
  totalBudget     Float    @default(0.0)
  spentBudget     Float    @default(0.0)
  maxRedemptions  Int      @default(1000)
  redemptionCount Int      @default(0)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean  @default(true)
  targetCategory  String?
  targetCountry   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions     CampaignRedemption[]

  @@index([code])
  @@index([isActive])
}

model CampaignRedemption {
  id           String            @id @default(uuid())
  campaignId   String
  userId       String
  bookingId    String?
  discounted   Float
  createdAt    DateTime          @default(now())

  campaign     MarketingCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([userId])
}

model AbandonedEvent {
  id           String   @id @default(uuid())
  userId       String
  eventType    String   // SEARCH, SERVICE_VIEW, PROVIDER_VIEW, BOOKING_FORM, PAYMENT
  metadataJson String?
  recovered    Boolean  @default(false)
  recoveredAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([eventType])
}

model RefundPolicyRecord {
  id               String   @id @default(uuid())
  name             String
  cancellationHours Int     @default(24)
  refundPercentage Float    @default(100.0)
  feeDeductionUsd  Float    @default(0.0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ExperimentRecord {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  variantsJson String   // JSON string e.g. ["control", "variant_a"]
  trafficPct   Float    @default(100.0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NotificationPreferenceRecord {
  id                  String   @id @default(uuid())
  userId              String   @unique
  bookingAlerts       Boolean  @default(true)
  paymentAlerts       Boolean  @default(true)
  marketingPromotions Boolean  @default(true)
  securityAlerts      Boolean  @default(true)
  supportUpdates      Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}


// ==========================================
// Phase 16 — Autonomous Marketplace Intelligence Models
// ==========================================

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnomalyStatus {
  DETECTED
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
}

enum EvaluationCategory {
  CORRECTNESS
  SAFETY
  HALLUCINATION
  TOOL_USAGE
  AUTHORIZATION
  POLICY_COMPLIANCE
}

model MarketplaceEvent {
  id        String   @id @default(uuid())
  eventName String
  payload   Json
  source    String   @default("system")
  region    String?
  category  String?
  userId    String?
  providerId String?
  timestamp DateTime @default(now())

  @@index([eventName])
  @@index([timestamp])
  @@index([region])
}

model Anomaly {
  id                String          @id @default(uuid())
  type              String
  severity          AnomalySeverity
  region            String?
  category          String?
  detectedAt        DateTime        @default(now())
  evidence          Json
  confidence        Float           @default(1.0)
  recommendedAction String
  status            AnomalyStatus   @default(DETECTED)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([type])
  @@index([status])
  @@index([severity])
}

model Recommendation {
  id                String         @id @default(uuid())
  title             String
  reason            String
  supportingMetrics Json
  affectedArea      String
  confidence        Float          @default(0.85)
  expectedImpactUsd Float?
  risk              AnomalySeverity@default(LOW)
  recommendedAction String
  approvalRequired  Boolean        @default(true)
  status            ApprovalStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([affectedArea])
}

model AutomationPolicy {
  id                      String   @id @default(uuid())
  name                    String   @unique
  triggerEvent            String
  conditionRules          Json
  actionType              String
  requiresApproval        Boolean  @default(true)
  maxExecutionFrequencyMs Int      @default(60000)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model AutomationExecution {
  id                String   @id @default(uuid())
  policyId          String
  triggerContext    Json
  actionTaken       String
  authorizationRole String
  actorId           String
  status            String
  result            Json
  createdAt         DateTime @default(now())
}

model ApprovalRequest {
  id           String         @id @default(uuid())
  actionType   String
  requestedBy  String
  context      Json
  riskLevel    AnomalySeverity@default(MEDIUM)
  status       ApprovalStatus @default(PENDING)
  reviewedBy   String?
  reviewReason String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
}

model DecisionAudit {
  id               String   @id @default(uuid())
  decisionId       String   @unique @default(uuid())
  actorId          String
  actorType        String   // USER, AI_AGENT, AUTOMATION_POLICY
  inputContext     Json
  policyName       String
  recommendationId String?
  decision         String
  actionTaken      String
  result           Json
  rollbackInfo     Json?
  timestamp        DateTime @default(now())

  @@index([actorId])
  @@index([policyName])
  @@index([timestamp])
}

model AISession {
  id           String   @id @default(uuid())
  userId       String
  sessionType  String
  agentId      String
  modelVersion String
  promptVersion String
  context      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AIEvaluation {
  id             String             @id @default(uuid())
  inputContext   Json
  expectedResult Json
  actualResult   Json
  score          Float
  evaluatorId    String
  modelVersion   String
  promptVersion  String
  category       EvaluationCategory
  failureReason  String?
  createdAt      DateTime           @default(now())
}

model RiskSignal {
  id         String   @id @default(uuid())
  entityType String   // USER, PROVIDER, BOOKING, PAYMENT
  entityId   String
  riskType   String
  riskScore  Float
  signals    Json
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([status])
}

model CapacitySnapshot {
  id                 String   @id @default(uuid())
  region             String
  category           String
  availableSlots     Int
  bookedSlots        Int
  utilizationPct     Float
  responseTimeAvgSec Float
  activeProvidersCount Int
  snapshotTime       DateTime @default(now())

  @@index([region, category])
  @@index([snapshotTime])
}

// Phase 17 — Autonomous Marketplace Decision Intelligence & AI Agent Models

model DecisionContextRecord {
  id            String   @id @default(uuid())
  correlationId String
  timestamp     DateTime @default(now())
  market        String   @default("GLOBAL")
  region        String   @default("GLOBAL")
  category      String?
  signals       Json
  features      Json
  riskLevel     String   @default("LOW")
  createdAt     DateTime @default(now())

  @@index([correlationId])
  @@index([region, category])
}

model MarketplaceDecision {
  id               String   @id @default(uuid())
  decisionType     String
  correlationId    String
  contextId        String?
  candidateActions Json
  selectedAction   Json
  confidence       Float
  expectedImpact   Json
  riskLevel        String   @default("LOW")
  approvalRequired Boolean  @default(false)
  approvalId       String?
  explanation      String
  status           String   @default("GENERATED")
  executedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([correlationId])
  @@index([status])
}

model DemandRevenueForecast {
  id             String   @id @default(uuid())
  forecastType   String
  targetHorizon  String
  region         String   @default("GLOBAL")
  category       String?
  expectedValue  Float
  lowerBound     Float
  upperBound     Float
  confidence     Float
  method         String   @default("EXPONENTIAL_SMOOTHING")
  inputMetadata  Json
  explanation    String
  generatedAt    DateTime @default(now())

  @@index([forecastType, targetHorizon])
  @@index([region, category])
}

model ScenarioSimulation {
  id               String   @id @default(uuid())
  scenarioName     String
  baselineContext  Json
  adjustedParams   Json
  projectedMetrics Json
  deltaPct         Json
  confidence       Float
  riskLevel        String   @default("LOW")
  simulatedBy      String   @default("SYSTEM")
  createdAt        DateTime @default(now())

  @@index([scenarioName])
}

model AgentDefinition {
  id                  String   @id @default(uuid())
  agentId             String   @unique
  name                String
  version             String   @default("1.0.0")
  purpose             String
  allowedTools        String[]
  allowedActions      String[]
  forbiddenActions    String[]
  requiredPermissions String[]
  riskLevel           String   @default("LOW")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([agentId])
}

model AgentExecution {
  id            String               @id @default(uuid())
  agentId       String
  correlationId String
  objective     String
  status        String               @default("RUNNING")
  steps         AgentExecutionStep[]
  startedAt     DateTime             @default(now())
  completedAt   DateTime?

  @@index([agentId])
  @@index([correlationId])
}

model AgentExecutionStep {
  id           String         @id @default(uuid())
  executionId  String
  stepNumber   Int
  toolName     String
  inputPayload Json
  outputResult Json?
  status       String         @default("PENDING")
  riskLevel    String         @default("LOW")
  executedAt   DateTime       @default(now())
  execution    AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model AgentToolPermission {
  id             String   @id @default(uuid())
  agentId        String
  toolName       String
  permission     String
  riskLevel      String   @default("LOW")
  isAllowed      Boolean  @default(true)
  requiresReview Boolean  @default(false)

  @@unique([agentId, toolName])
  @@index([agentId])
}

model AiEvaluationMetric {
  id           String   @id @default(uuid())
  modelName    String
  evalType     String
  score        Float
  sampleCount  Int
  evalContext  Json
  evaluatedAt  DateTime @default(now())

  @@index([modelName, evalType])
}

model DecisionAuditRecord {
  id            String   @id @default(uuid())
  decisionId    String
  actorId       String
  actionType    String
  inputSnapshot Json
  outputResult  Json
  approvalState String   @default("APPROVED")
  timestamp     DateTime @default(now())

  @@index([decisionId])
  @@index([actorId])
}
