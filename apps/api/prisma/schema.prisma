generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  customerProfile CustomerProfile?
  providerProfile ProviderProfile?
  refreshTokens   RefreshToken[]
  bookings        Booking[]
  reviews         Review[]
  notifications   Notification[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  businessName   String
  description    String?
  phone          String?
  address        String?
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([isVerified])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]
}

model Service {
  id          String   @id @default(uuid())
  providerId  String
  categoryId  String
  name        String
  description String?
  price       Float
  duration    Int      // Duration in minutes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id])
  bookings Booking[]
}

model Booking {
  id          String        @id @default(uuid())
  customerId  String
  serviceId   String
  status      BookingStatus @default(PENDING)
  scheduledAt DateTime
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customer User    @relation(fields: [customerId], references: [id])
  service  Service @relation(fields: [serviceId], references: [id])
  payment  Payment?
  review   Review?

  @@index([customerId, status])
  @@index([serviceId, status])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  amount        Float
  status        PaymentStatus @default(PENDING)
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  authorId   String
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Referral {
  id             String         @id @default(uuid())
  referrerId     String
  referredUserId String?
  code           String         @unique
  status         ReferralStatus @default(PENDING)
  rewardAmount   Float          @default(15.00)
  createdAt      DateTime       @default(now())
  redeemedAt     DateTime?
}

enum ReferralStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}
model Device {
  id              String   @id @default(uuid())
  deviceId        String   @unique
  name            String
  deviceType      String
  ownerId         String
  healthScore     Float    @default(100.0)
  status          String   @default("ONLINE")
  lastHeartbeatAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

model InsuranceClaim {
  id              String   @id @default(uuid())
  claimId         String   @unique
  policyNumber    String
  providerId      String
  estimatedCost   Float
  approvedCost    Float?
  status          String   @default("PENDING")
  filedAt         DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([providerId])
  @@index([status])
}

model FranchiseBranch {
  id              String   @id @default(uuid())
  branchId        String   @unique
  franchiseId     String
  name            String
  territoryCode   String
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([franchiseId])
  @@index([territoryCode])
}

model SupplierPO {
  id              String   @id @default(uuid())
  orderId         String   @unique
  supplierId      String
  totalAmount     Float
  status          String   @default("ISSUED")
  issuedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
}

model LicenseVerification {
  id              String   @id @default(uuid())
  verificationId  String   @unique
  providerId      String
  licenseType     String
  licenseNumber   String
  status          String   @default("PENDING")
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([providerId])
}

model VerifiableCredential {
  id              String   @id @default(uuid())
  credentialId    String   @unique
  userId          String
  credentialType  String
  issuer          String
  isValid         Boolean  @default(true)
  issuedAt        DateTime @default(now())

  @@index([userId])
}

model SmartCityRequest {
  id              String   @id @default(uuid())
  requestId       String   @unique
  municipalityId  String
  category        String
  priority        String   @default("MEDIUM")
  status          String   @default("OPEN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([municipalityId])
  @@index([status])
}

model IncidentReport {
  id              String   @id @default(uuid())
  incidentId      String   @unique
  serviceName     String
  severity        String   @default("WARNING")
  status          String   @default("OPEN")
  remediatedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([serviceName])
  @@index([status])
}

model EdgeWorkerRoute {
  id              String   @id @default(uuid())
  routeId         String   @unique
  regionCode      String
  originUrl       String
  edgeUrl         String
  latencyMs       Int      @default(15)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([regionCode])
}
model LoyaltyAccount {
  id              String   @id @default(uuid())
  userId          String   @unique
  tier            String   @default("BRONZE")
  points          Int      @default(0)
  cashbackBalance Float    @default(0.0)
  referralCode    String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tier])
}

model AdCampaign {
  id              String   @id @default(uuid())
  campaignId      String   @unique
  providerId      String
  title           String
  bidCpc          Float
  budget          Float
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([providerId])
  @@index([status])
}

model CustomerCrmRecord {
  id              String   @id @default(uuid())
  recordId        String   @unique
  providerId      String
  customerId      String
  leadScore       Int      @default(50)
  notes           String?
  nextFollowUpAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([providerId, customerId])
}

model ProcurementContract {
  id              String   @id @default(uuid())
  contractId      String   @unique
  organizationId  String
  vendorName      String
  totalBudget     Float
  status          String   @default("PENDING_APPROVAL")
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model WorkforceShift {
  id              String   @id @default(uuid())
  shiftId         String   @unique
  organizationId  String
  staffId         String
  startTime       DateTime
  endTime         DateTime
  overtimeHours   Float    @default(0.0)
  status          String   @default("SCHEDULED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, staffId])
}

model KnowledgeGraphEdge {
  id              String   @id @default(uuid())
  edgeId          String   @unique
  sourceEntity    String
  targetEntity    String
  relationship    String
  weight          Float    @default(1.0)
  createdAt       DateTime @default(now())

  @@index([sourceEntity, targetEntity])
}

model SmartContractEscrow {
  id              String   @id @default(uuid())
  escrowId        String   @unique
  bookingId       String   @unique
  amount          Float
  milestone       String
  isReleased      Boolean  @default(false)
  disputeStatus   String   @default("NONE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isReleased])
}

model ApiMarketplaceApp {
  id              String   @id @default(uuid())
  appId           String   @unique
  developerId     String
  name            String
  apiKey          String   @unique
  ratePlan        String   @default("FREE")
  monthlyRequests Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([developerId])
}

model BiAnalyticsReport {
  id              String   @id @default(uuid())
  reportId        String   @unique
  title           String
  metricsJson     String
  generatedAt     DateTime @default(now())
}

model AutonomousRecoveryAction {
  id              String   @id @default(uuid())
  actionId        String   @unique
  clusterName     String
  targetDeployment String
  reason          String
  status          String   @default("SUCCESS")
  executedAt      DateTime @default(now())

  @@index([clusterName])
}

model EdgeInferenceCache {
  id              String   @id @default(uuid())
  cacheId         String   @unique
  region          String
  modelKey        String
  latencyMs       Int      @default(8)
  updatedAt       DateTime @updatedAt

  @@index([region, modelKey])
}
model FranchiseNetwork {
  id              String   @id @default(uuid())
  networkId       String   @unique
  regionCode      String
  name            String
  royaltyRate     Float    @default(0.08)
  activeBranches  Int      @default(1)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([regionCode])
}

model EmergencySosBooking {
  id              String   @id @default(uuid())
  sosId           String   @unique
  customerId      String
  serviceCategory String
  latitude        Float
  longitude       Float
  priorityScore   Int      @default(100)
  status          String   @default("DISPATCHED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model InsuranceDamageClaim {
  id              String   @id @default(uuid())
  damageClaimId   String   @unique
  policyId        String
  providerId      String
  assessedAmount  Float
  coverageValid   Boolean  @default(true)
  status          String   @default("UNDER_REVIEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([policyId])
}

model SmartHomeDevice {
  id              String   @id @default(uuid())
  smartDeviceId   String   @unique
  homeId          String
  deviceType      String
  telemetryTopic  String
  lastStatus      String   @default("HEALTHY")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([homeId])
}

model WorkforceSchedule {
  id              String   @id @default(uuid())
  scheduleId      String   @unique
  organizationId  String
  weekNumber      Int
  aiOptimized     Boolean  @default(true)
  totalShiftHours Float    @default(160.0)
  createdAt       DateTime @default(now())

  @@index([organizationId])
}

model ProcurementPurchaseRequest {
  id              String   @id @default(uuid())
  requestId       String   @unique
  organizationId  String
  itemDescription String
  estimatedCost   Float
  approvalLevel   String   @default("MANAGER")
  status          String   @default("SUBMITTED")
  createdAt       DateTime @default(now())

  @@index([organizationId])
}

model CommerceGraphNode {
  id              String   @id @default(uuid())
  nodeId          String   @unique
  entityType      String
  label           String
  propertiesJson  String
  createdAt       DateTime @default(now())

  @@index([entityType])
}

model AutonomousSettlement {
  id              String   @id @default(uuid())
  settlementId    String   @unique
  escrowId        String
  grossAmount     Float
  platformFee     Float
  netPayout       Float
  status          String   @default("SETTLED")
  settledAt       DateTime @default(now())

  @@index([escrowId])
}

model DeveloperWebhook {
  id              String   @id @default(uuid())
  webhookId       String   @unique
  appId           String
  targetUrl       String
  eventsJson      String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([appId])
}

model OpsScalingAction {
  id              String   @id @default(uuid())
  scalingId       String   @unique
  clusterId       String
  targetReplicas  Int
  triggerMetric   String
  executedAt      DateTime @default(now())

  @@index([clusterId])
}

model EdgeOfflineInference {
  id              String   @id @default(uuid())
  inferenceId     String   @unique
  edgeNodeId      String
  inputHash       String
  outputJson      String
  latencyMs       Int      @default(5)
  executedAt      DateTime @default(now())

  @@index([edgeNodeId])
}
