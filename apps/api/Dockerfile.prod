# Multi-stage production Dockerfile for NestJS API Service
# Stage 1: Build stage
FROM node:22-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm@9.15.4

# Copy workspace dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy application source & schema
COPY apps/api ./apps/api

# Generate Prisma Client & compile NestJS application
WORKDIR /app/apps/api
RUN pnpm exec prisma generate
RUN pnpm run build

# Stage 2: Production runner stage
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=5001

# Install dumb-init for graceful signal handling (PID 1 process reaper)
RUN apk add --no-cache dumb-init
RUN npm install -g pnpm@9.15.4

# Copy dependency manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/

# Install production dependencies only
RUN pnpm install --prod --frozen-lockfile

# Copy compiled artifacts & schema
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma

# Generate Prisma client for runtime
WORKDIR /app/apps/api
RUN pnpm exec prisma generate

WORKDIR /app

# DevSecOps: Non-root execution & least-privilege permissions
RUN chown -R node:node /app
USER node

# Health check using Phase 23 bounded liveness endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:5001/api/v1/health/live || exit 1

EXPOSE 5001

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "apps/api/dist/main.js"]
