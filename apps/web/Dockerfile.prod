# Multi-stage production Dockerfile for Next.js Web Application
# Stage 1: Build stage
FROM node:22-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm@9.15.4

# Copy monorepo configuration
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy application source & compile Next.js
COPY apps/web ./apps/web
RUN pnpm --filter web run build

# Stage 2: Production runner stage
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

# Install dumb-init for graceful termination signal propagation
RUN apk add --no-cache dumb-init

# Copy Next.js production build artifacts
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/.next ./apps/web/.next
COPY --from=builder /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=builder /app/apps/web/package.json ./apps/web/package.json

# DevSecOps: Non-root execution
RUN chown -R node:node /app
USER node

# Health check probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ || exit 1

EXPOSE 3000

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node_modules/.bin/next", "start", "apps/web"]
