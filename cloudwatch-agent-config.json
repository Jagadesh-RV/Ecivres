{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/ecivres/production/nginx/access",
            "log_stream_name": "{instance_id}",
            "timestamp_format": "%d/%b/%Y:%H:%M:%S %z"
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/ecivres/production/nginx/error",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/ecivres/api.log",
            "log_group_name": "/ecivres/production/api",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
