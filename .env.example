# Environment
APP_ENV=development
API_PORT=3000

# Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/ecivres?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ecivres

# Authentication Secrets
JWT_ACCESS_SECRET=super_secret_access_token_key_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_token_key_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# External Services Placeholders
# STORAGE_BUCKET=
# PAYMENT_SECRET=
# NOTIFICATION_KEY=
