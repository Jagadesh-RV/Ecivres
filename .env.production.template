# EcivreS Production Environment Variables Template
NODE_ENV=production
API_PORT=5001
CORS_ORIGINS=https://ecivres.com,https://admin.ecivres.com

# PostgreSQL Database
POSTGRES_USER=ecivres_prod_user
POSTGRES_PASSWORD=replace_with_strong_production_password
POSTGRES_DB=ecivres_production_db
DATABASE_URL=postgresql://ecivres_prod_user:replace_with_strong_production_password@rds.ecivres.internal:5432/ecivres_production_db?sslmode=require

# Redis Cache & Queue
REDIS_HOST=redis.ecivres.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_prod_password

# Authentication & JWT Security
JWT_SECRET=replace_with_secure_random_256bit_jwt_secret
JWT_REFRESH_SECRET=replace_with_secure_random_256bit_jwt_refresh_secret

# AWS S3 Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA_REPLACE_WITH_PRODUCTION_KEY
AWS_SECRET_ACCESS_KEY=replace_with_production_secret_key
AWS_S3_BUCKET=ecivres-marketplace-production-storage

# Resend Transactional Emails
RESEND_API_KEY=re_replace_with_live_resend_api_key
EMAIL_FROM=EcivreS Marketplace <notifications@ecivres.com>

# Firebase Cloud Messaging (FCM Push Notifications)
FIREBASE_PROJECT_ID=ecivres-marketplace-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@ecivres-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"

# Sentry Monitoring
SENTRY_DSN=https://replace_with_sentry_dsn@o0.ingest.sentry.io/0
