# Root .dockerignore for EcivreS Monorepo
node_modules
*/node_modules
*/*/node_modules

# Version control & IDEs
.git
.gitignore
.github
.idea
.vscode

# Build outputs & caches
dist
build
.next
out
coverage
.turbo
.pnpm-store
*.tsbuildinfo

# Sub-projects excluded from backend/web images
apps/mobile
docs
terraform
helm
backups
*.dump

# Environment files & secrets
.env
.env.*
!.env.example
!.env.staging.example
*.pem
*.key
*.cert

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
scratch/
tmp/
repo_structure.txt
api_error*.log
